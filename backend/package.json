{
  "name": "school-management-backend",
  "version": "1.0.0",
  "description": "Backend for THPT Student Management System",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --exec \"node --use-system-ca\" src/app.js",
    "start": "node --use-system-ca src/app.js",
    "test": "node --test tests/access.test.js tests/exams.test.js tests/chatbot.test.js tests/lesson-notes.test.js",
    "db:push": "prisma db push",
    "db:create-exam-table": "node prisma/create_exam_schedule_table.js",
    "db:create-lesson-notes-table": "node prisma/create_lesson_notes_table.js",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed-multi-year": "node prisma/seed_multi_year_demo.js",
    "db:create-enrollment-table": "node prisma/create_student_enrollment_table.js",
    "db:promote-demo": "node prisma/promote_demo_cohorts.js",
    "db:verify-multi-year": "node prisma/verify_multi_year_demo.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  }
}
